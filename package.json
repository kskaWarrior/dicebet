{
  "name": "dicebet",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "test": "npm run test -w apps/api",
    "build": "npm run build -w apps/api && npm run generate -w apps/web",
    "typecheck": "npm run typecheck -w apps/api",
    "test:integration": "npm run test:integration -w apps/api",
    "db:migrate": "node node_modules/@kskawarrior/rgs-core/db/migrate.mjs && node db/migrate.mjs"
  }
}
