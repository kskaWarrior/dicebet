  },
  "dependencies": {
    "@kskawarrior/rgs-core": "^0.9.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "jose": "^5.9.0",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
