# Copie para apps/api/.env para `npm run dev:api` contra o docker-compose.
DATABASE_URL=postgres://dicebet_api:dicebet_api@127.0.0.1:52322/dicebet
# Auth (ADR-0001): exatamente um dos dois. Local = segredo HS256 do GoTrue
# (o mesmo AUTH_JWT_SECRET do .env da raiz).
AUTH_JWT_SECRET=
# AUTH_JWKS_URL=https://auth.<dominio>/.well-known/jwks.json   (se assinar com chave assimétrica)
AUTH_AUDIENCE=authenticated

# Stripe (só chaves de test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Origens permitidas, separadas por vírgula: web + shells Capacitor
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost

# Para onde o Stripe Checkout manda o usuário de volta
CHECKOUT_RETURN_URL=http://localhost:3000

PORT=8080
