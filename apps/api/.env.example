# Copie para apps/api/.env para `npm run dev:api` contra o banco único do repo `rgs`
# (rollout RGS, docs/adr/0002-carteira-de-rgs.md): `scripts/local-up.sh` sobe o compose
# de lá e aplica os schemas rgs + dicebet.
DATABASE_URL=postgres://dicebet_api:dicebet_api@127.0.0.1:57332/rgs
# Auth (ADR-0001): exatamente um dos dois. Local = segredo HS256 do GoTrue
# (o AUTH_JWT_SECRET do .env do repo rgs, copiado para o .env da raiz).
AUTH_JWT_SECRET=
# AUTH_JWKS_URL=https://auth.<dominio>/.well-known/jwks.json   (se assinar com chave assimétrica)
AUTH_AUDIENCE=authenticated

# Origens permitidas, separadas por vírgula: web + shells Capacitor
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost

PORT=8080

# E13: segredo HS256 com que o RGS assina/valida sessões de jogo (POST /sessions). Só é
# usado por esse módulo, novo e aditivo — as rotas existentes (bets/seeds/wallet)
# continuam em AUTH_JWT_SECRET/AUTH_JWKS_URL acima, sem mudança.
RGS_SESSION_SECRET=
GAME=dicebet
