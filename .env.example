# Variáveis do docker-compose.yml. `scripts/local-up.sh` gera o `.env` da raiz
# (segredo aleatório) se ele não existir; este arquivo só documenta.
#
# Segredo HS256 que o GoTrue usa para assinar e a API para verificar (ADR-0001).
AUTH_JWT_SECRET=troque-por-32-bytes-aleatorios
# Portas no host (3000/8080 por padrão); troque se já houver algo nelas.
WEB_PORT=3000
API_PORT=8080
# Senha do role `dicebet_api` (o migrate cria, a api usa); troque fora do local.
API_DB_PASSWORD=dicebet_api
# Stripe test mode (opcional localmente: sem elas, só o depósito não funciona).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
