# Variáveis do docker-compose.yml. `scripts/local-up.sh` gera o `.env` da raiz
# (copiando o AUTH_JWT_SECRET do `.env` do repo `rgs`) se ele não existir; este
# arquivo só documenta.
#
# Segredo HS256 que o GoTrue do repo `rgs` usa para assinar e a API para verificar
# (rollout RGS, docs/adr/0002-carteira-de-rgs.md).
AUTH_JWT_SECRET=troque-por-32-bytes-aleatorios
# Portas no host (8080/3000 por padrão); troque se já houver algo nelas — os
# jogos irmãos rodam juntos nesta máquina.
API_PORT=8080
WEB_PORT=3000
# Senha do role `dicebet_api` (o migrate cria, a api usa); troque fora do local.
API_DB_PASSWORD=dicebet_api
